<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_cream"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/wa_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B98326"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="0.06" />

    <!-- autoSize (Android 8+): the text takes the largest size that fits its share of the widget -->
    <TextView
        android:id="@+id/wa_ar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:textDirection="rtl"
        android:textColor="#15314A"
        android:textSize="22sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeMaxTextSize="34sp"
        android:autoSizeStepGranularity="1sp" />

    <TextView
        android:id="@+id/wa_en"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center"
        android:textColor="#2C4560"
        android:textSize="14sp"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeStepGranularity="1sp" />
</LinearLayout>
