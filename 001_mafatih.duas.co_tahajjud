  <script>
    function setInitialTheme() {
      let userPrefers = localStorage.getItem('theme');
      // highest priority for user's explicit choice
      if (userPrefers == 'dark' || userPrefers == 'light') {
        document.querySelector('html').dataset.bsColorScheme = userPrefers;
        return userPrefers;
      }
      // next priority for user's implicit choice
      if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.querySelector('html').dataset.bsColorScheme = 'dark';
        return 'dark';
      }
      // otherwise default is light
      else {
        document.querySelector('html').dataset.bsColorScheme = 'light';
        return 'light';
      }
    }
    setInitialTheme();
  </script>

  
