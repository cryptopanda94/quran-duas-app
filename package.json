{
  "name": "quran-duas-app",
  "version": "1.0.0",
  "private": true,
  "description": "Shia Quran & Duas app for iOS and Android (Capacitor)",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "native:setup": "node scripts/native-setup.mjs",
    "sync": "node scripts/build-web.mjs && npx cap sync && node scripts/ios-plugins.mjs",
    "ios": "npx cap open ios",
    "android": "npx cap open android",
    "assets": "npx capacitor-assets generate --ios --android",
    "ios:plugins": "node scripts/ios-plugins.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@capacitor/assets": "^3.0.5"
  }
}
